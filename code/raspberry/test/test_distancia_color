import cv2
import numpy as np
import sys

def navegacion_por_perspectiva():
    # Detectar OS para abrir la cámara correctamente
    if sys.platform.startswith('win'):
        cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)
    else:
        cap = cv2.VideoCapture(0, cv2.CAP_V4L2)
        
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    # Kernels para limpiar la imagen (El "pegamento" que hablamos antes)
    kernel_abrir = np.ones((5,5), np.uint8)
    kernel_cerrar = np.ones((15,15), np.uint8)

    # --- PARÁMETROS DEL TÚNEL DE CONDUCCIÓN ---
    # Coordenadas (X, Y) para las líneas del camino
    horizonte_y = 200 # Hasta dónde llega la "mirada" a lo lejos
    base_y = 480      # El fondo de la pantalla (parachoques)
    
    # Línea Izquierda del camino
    camino_izq_base = (140, base_y)
    camino_izq_tope = (260, horizonte_y)
    
    # Línea Derecha del camino
    camino_der_base = (500, base_y)
    camino_der_tope = (380, horizonte_y)
    
    # Línea de Choque (Reversa)
    linea_choque_y = 400 

    def procesar_color(mascara, color_dibujo, nombre_objeto):
        contornos, _ = cv2.findContours(mascara, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        objeto_mas_cercano = None
        max_y_base = 0 # Buscamos el objeto que esté MÁS ABAJO en la pantalla
        
        for contorno in contornos:
            area = cv2.contourArea(contorno)
            if area > 1000:
                x, y, w, h = cv2.boundingRect(contorno)
                y_base = y + h # La parte de abajo del pilar
                
                # Si este objeto está más abajo que el anterior, es el nuevo "más cercano"
                if y_base > max_y_base:
                    max_y_base = y_base
                    objeto_mas_cercano = (x, y, w, h)
        
        # Si encontramos un objeto, lo dibujamos
        if objeto_mas_cercano:
            x, y, w, h = objeto_mas_cercano
            centro_x = x + (w // 2)
            y_base = y + h
            
            # Dibujar el cuadro y un círculo en la BASE (no en el centro)
            cv2.rectangle(frame, (x, y), (x + w, y + h), color_dibujo, 2)
            cv2.line(frame, (x, y), (x + w, y + h), color_dibujo, 2) # Línea vertical para visualizar la altura
            cv2.circle(frame, (centro_x, y_base), 5, (255, 255, 255), -1)
            cv2.putText(frame, f"{nombre_objeto} Base Y:{y_base}", (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color_dibujo, 2)
            
            return centro_x, y_base
        
        return None, None

    while True:
        ret, frame = cap.read()
        if not ret: break

        # 1. Aplicar Recorte (ROI) - Ignoramos el techo/luces del laboratorio
        # Solo vemos desde la coordenada Y=150 hasta el final
        roi = frame[150:480, 0:640]
        hsv_frame = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)

        # 2. Filtrado de Color (Más exigente con la saturación para ignorar el suelo)
        rojo_bajo_1 = np.array([0, 120, 50])
        rojo_alto_1 = np.array([10, 255, 255])
        rojo_bajo_2 = np.array([170, 120, 50])
        rojo_alto_2 = np.array([179, 255, 255])

        mascara_r1 = cv2.inRange(hsv_frame, rojo_bajo_1, rojo_alto_1)
        mascara_r2 = cv2.inRange(hsv_frame, rojo_bajo_2, rojo_alto_2)
        mascara_roja = cv2.add(mascara_r1, mascara_r2)
        
        # Operaciones morfológicas para evitar que el pilar se parta en dos
        mascara_roja = cv2.morphologyEx(mascara_roja, cv2.MORPH_OPEN, kernel_abrir)
        mascara_roja = cv2.morphologyEx(mascara_roja, cv2.MORPH_CLOSE, kernel_cerrar)

        
        # Debido a que analizamos el ROI (imagen cortada), los puntos del pilar 
        # salen relativos al recorte. Para dibujarlos en el cuadro original, sumamos 150 a la Y.
        # En una versión final, analizaríamos todo directamente, pero esto es útil para debug.

        # Ejecutamos el análisis temporal sobre la imagen COMPLETA para no complicar tus coordenadas ahora
        hsv_completo = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        mascara_completa = cv2.inRange(hsv_completo, rojo_bajo_1, rojo_alto_1) # Versión simplificada
        mascara_completa = cv2.morphologyEx(mascara_completa, cv2.MORPH_OPEN, kernel_abrir)
        mascara_completa = cv2.morphologyEx(mascara_completa, cv2.MORPH_CLOSE, kernel_cerrar)

        centro_rojo_x, base_rojo_y = procesar_color(mascara_completa, (0, 0, 255), "PILAR ROJO")

        # =========================================================
        # 4. LA LÓGICA DE DECISIÓN ESPACIAL (Sin Matemáticas Complejas)
        # =========================================================
        if centro_rojo_x and base_rojo_y:
            
            # Condición 1: ¿Pasó la línea de peligro?
            if base_rojo_y >= linea_choque_y:
                print("¡CHOQUE INMINENTE! Ejecutando Reversa...")
            else:
                # Condición 2: El pilar está delante, pero ¿está DENTRO de nuestro carril?
                # Interpolación simple para saber el ancho del carril a la altura del pilar (opcional)
                # Por ahora, una regla bruta: si está en el medio de la pantalla (entre 200 y 440)
                if 200 < centro_rojo_x < 440:
                    print("Pilar Rojo en el camino. Orden de Evasión Activa.")
                else:
                    print("Pilar Rojo detectado, pero está fuera del carril. Vía libre.")

        # 3. Dibujar la Interfaz de Navegación (Túnel y Línea de Choque)
        # Línea izquierda (Azul)
        cv2.line(frame, camino_izq_base, camino_izq_tope, (255, 0, 0), 2)
        # Línea derecha (Azul)
        cv2.line(frame, camino_der_base, camino_der_tope, (255, 0, 0), 2)
        # Línea de Choque Inminente (Roja, a lo ancho de toda la pantalla)
        cv2.line(frame, (0, linea_choque_y), (640, linea_choque_y), (0, 0, 255), 3)
        cv2.putText(frame, "ZONA DE REVERSA", (10, linea_choque_y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2)


        cv2.imshow("Robot Vision", frame)
        
        if cv2.waitKey(1) & 0xFF == ord('q'): break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    navegacion_por_perspectiva()